new file mode 100644
index 0000000..8c6893e
--- /dev/null
+++ b/tests/bc250-native-mesh/qtask_cond.task
@@ -0,0 +1,11 @@
+#version 460
+#extension GL_EXT_mesh_shader : require
+layout(local_size_x=1) in;
+void main() {
+   /* Culling-style conditional emission, alternating per indirect record via
+    * DrawID so consecutive records write disjoint slot subsets of the shared
+    * scratch. Non-emitting workgroups must leave zero records (driver-side),
+    * otherwise the next record's mesh draw consumes stale data. */
+   if ((gl_WorkGroupID.x + gl_DrawID) % 2 == 0)
+      EmitMeshTasksEXT(2,1,1);
+}
diff --git a/tests/bc250-native-mesh/query_test.c b/tests/bc250-native-mesh/query_test.c
