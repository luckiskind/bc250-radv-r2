+               continue;
+            }
+            uint64_t cost = (uint64_t)ib->cdw * 9 + 256;
+            if (cost > limit - bc250_capture_bytes) {
+               fprintf(stderr, "BC250RAW LIMIT bytes=%llu\n", (unsigned long long)bc250_capture_bytes);
+               bc250_capture_limited = true;
+               return;
+            }
+            uint64_t id = ++bc250_capture_id;
+            fprintf(stderr, "BC250RAW IB kind=%s depth=%u ip=%u va=%016llx dw=%u id=%llu\n",
