+                  bc250_capture_cache[slot].va = ib->va;
+                  bc250_capture_cache[slot].dw = ib->cdw;
+                  bc250_capture_cache[slot].ip = cs->hw_ip;
+                  bc250_capture_cache[slot].id = id;
+               }
+            }
+         }
+      }
+      if (cs)
+         fputs("BC250RAW DEPTH_LIMIT\n", stderr);
+   }
