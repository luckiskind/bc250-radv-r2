@@ -0,0 +1,17 @@
+#version 460
+#extension GL_EXT_mesh_shader : require
+layout(local_size_x=32) in;
+struct Payload { uint sentinel; uint taskIndex; };
+taskPayloadSharedEXT Payload payload;
+#ifdef APP_DESCRIPTOR
+layout(set=0,binding=0) uniform ApplicationData { uint value; } app;
+#else
+layout(push_constant) uniform ApplicationData { uint value; } app;
+#endif
+void main() {
+    if (gl_LocalInvocationIndex==0) {
+        payload.sentinel=app.value;
+        payload.taskIndex=0;
+    }
+    EmitMeshTasksEXT(1,1,1);
+}
diff --git a/tests/bc250-native-mesh/atomic.task b/tests/bc250-native-mesh/atomic.task
new file mode 100644
index 0000000..64ff880
--- /dev/null
+++ b/tests/bc250-native-mesh/atomic.task
@@ -0,0 +1,17 @@
+#version 460
+#extension GL_EXT_mesh_shader : require
+layout(local_size_x=64) in;
+struct Payload { uint sentinel; uint taskIndex; };
+taskPayloadSharedEXT Payload payload;
+void main() {
+    if (gl_LocalInvocationIndex==0) {
+        payload.sentinel=0;
+        payload.taskIndex=gl_WorkGroupID.x;
+    }
+    barrier();
+    atomicAdd(payload.sentinel,1);
+    barrier();
+    if (gl_LocalInvocationIndex==0 && payload.sentinel==64)
+        payload.sentinel=0x12345678u;
+    EmitMeshTasksEXT(1,1,1);
+}
