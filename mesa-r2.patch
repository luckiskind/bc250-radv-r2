diff --git a/tests/bc250-native-mesh/points.mesh b/tests/bc250-native-mesh/points.mesh
new file mode 100644
index 0000000..f2b65d0
--- /dev/null
+++ b/tests/bc250-native-mesh/points.mesh
@@ -0,0 +1,20 @@
+#version 460
+#extension GL_EXT_mesh_shader : require
+layout(local_size_x=32) in;
+layout(points,max_vertices=4,max_primitives=4) out;
+layout(location=0) perprimitiveEXT out vec3 color[];
+void main() {
+    SetMeshOutputsEXT(4, 4);
+    uint lane=gl_LocalInvocationIndex;
+    // Four 8x8 points in the quadrants: left two red, right two green.
+    // Exercises the corners=1 expansion epilogue path (scalar index rewrite).
+    vec2 pos[4]=vec2[4](vec2(-0.5,-0.5),vec2(-0.5,0.5),vec2(0.5,-0.5),vec2(0.5,0.5));
+    for(uint i=lane;i<4;i+=32) {
+        gl_MeshVerticesEXT[i].gl_Position=vec4(pos[i],0,1);
+        gl_MeshVerticesEXT[i].gl_PointSize=8.0;
+    }
+    if(lane<4) {
+        gl_PrimitivePointIndicesEXT[lane]=lane;
+        color[lane]=(lane<2)?vec3(1,0,0):vec3(0,1,0);
+    }
+}
