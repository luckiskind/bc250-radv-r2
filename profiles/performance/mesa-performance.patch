+/* Pressure-neutral source guard: move scalar arithmetic closer to its
+ * consumers only if each divergent source is already needed there or later.
+ * Allow cross-block sinking when all consumers share a dominated block
+ * in the same loop and divergent operands are already needed there.
+ * Unlike generic nir_move_alu, allow multiple distinct nonconstant sources.
+ * Preserve exact opcode/flags; no reassociation, cloning or memory movement. */
+/* Sink complete ALU decode chains into their sole consumer block. This
+ * may repeat cheap arithmetic in a consumer loop, but never reloads memory,
+ * changes precision, or moves derivatives. */
+static bool
+bc250_has_packed_decode(nir_def *v, unsigned depth)
+{
+   if (!depth || nir_def_instr(v)->type != nir_instr_type_alu) return false;
+   nir_alu_instr *a = nir_instr_as_alu(nir_def_instr(v));
+   if (a->op == nir_op_extract_u8 || a->op == nir_op_extract_u16) return true;
+   for (unsigned i = 0; i < nir_op_infos[a->op].num_inputs; ++i)
+      if (bc250_has_packed_decode(a->src[i].src.ssa, depth - 1)) return true;
+   return false;
+}
+
+static bool
+radv_bc250_shorten_alu(nir_shader *nir)
+{
+   bool progress = false;
+   unsigned moved = 0;
+   nir_foreach_function_impl(impl, nir) {
+      nir_metadata_require(impl, nir_metadata_dominance | nir_metadata_instr_index);
+      bool changed = false;
+      /* Revisit producers after sinking their consumers. Bound compile cost. */
+      for (unsigned round = 0; round < 8; ++round) {
+         bool again = false;
+         nir_foreach_block(block, impl) {
+            nir_foreach_instr_reverse_safe(instr, block) {
+               if (moved >= 128 || instr->type != nir_instr_type_alu) continue;
+               nir_alu_instr *alu = nir_instr_as_alu(instr);
+               if (alu->def.bit_size > 32 || !nir_instr_can_speculate(instr) ||
+                   !bc250_has_packed_decode(&alu->def, 4)) continue;
+               switch (alu->op) {
+               case nir_op_fmul: case nir_op_fadd: case nir_op_fneg:
+               case nir_op_iadd: case nir_op_imul: case nir_op_iand:
+               case nir_op_ior: case nir_op_ixor: case nir_op_ishl:
+               case nir_op_ushr: case nir_op_extract_u8: case nir_op_extract_u16:
+               case nir_op_u2f32: case nir_op_i2f32: case nir_op_mov:
+                  break;
+               default: continue;
+               }
+               nir_instr *first = NULL;
+               nir_block *target = NULL;
+               bool safe = true;
+               nir_foreach_use_including_if(use, &alu->def) {
+                  if (nir_src_is_if(use)) { safe = false; break; }
+                  nir_instr *u = nir_src_use_instr(use);
+                  if (u->type == nir_instr_type_phi || (target && u->block != target)) { safe = false; break; }
+                  target = u->block;
+                  if (!first || u->index < first->index) first = u;
+               }
+               if (!safe || !first || target == block || !nir_block_dominates(block, target)) continue;
+               nir_instr_move(nir_before_instr(first), instr);
+               nir_index_instrs(impl);
+               moved++; changed = true; again = true;
+            }
+         }
+         if (!again) break;
+      }
+      progress |= nir_progress(changed, impl, nir_metadata_control_flow);
+   }
+   if (debug_get_bool_option("BC250_LIFETIME_TRACE", false))
+      fprintf(stderr, "BC250_DECODE_SINK stage=%u moved=%u\n", nir->info.stage, moved);
+   return progress;
+}
