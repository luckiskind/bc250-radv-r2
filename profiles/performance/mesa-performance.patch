+/* Recording-path histogram only: not executed waves or a GPU timing claim. */
+static void
+bc250_profile_route(struct radv_cmd_buffer *cmd, unsigned route)
+{
+   if (!bcp_begin()) return;
+   const struct radv_graphics_pipeline *p = cmd->state.graphics_pipeline;
+   unsigned pieces = p ? p->bc250_direct_split_pieces : 0;
+   unsigned task = p && p->bc250_task_pipeline;
+   unsigned bucket = task ? 10 : MIN2(pieces, 9);
+   static uint64_t counts[3][11], total;
+   __atomic_add_fetch(&counts[route][bucket], 1, __ATOMIC_RELAXED);
+   uint64_t n = __atomic_add_fetch(&total, 1, __ATOMIC_RELAXED);
+   if (n != 1 && n % 512) return;
+   for (unsigned r = 0; r < 3; ++r)
+      for (unsigned b = 0; b < 11; ++b) {
+         uint64_t c = __atomic_load_n(&counts[r][b], __ATOMIC_RELAXED);
+         if (c) bcp_write("{\"kind\":\"mesh_route_recording\",\"pid\":%d,\"cpu_ns\":%llu,\"recorded_total\":%llu,\"route\":%u,\"piece_bucket\":%u,\"count\":%llu}\n",
+            (int)getpid(), (unsigned long long)bcp_now(), (unsigned long long)n,
+            r, b, (unsigned long long)c);
+      }
+}
