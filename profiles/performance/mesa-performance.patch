+/* Conservative first experiment: only 32-bit, constant-zero slot offsets.
+ * Keep holes within a slot; trim only unused trailing components. Unsupported
+ * addressing disables packing for the whole shader, not individual stores.
+ */
+static bool
+ms_dense_output_widths(nir_shader *shader, unsigned widths[64])
+{
+   if (shader->info.outputs_read_indirectly || shader->info.outputs_written_indirectly)
+      return false;
+   nir_foreach_function_impl(impl, shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *in = nir_instr_as_intrinsic(instr);
+            if (in->intrinsic != nir_intrinsic_store_per_vertex_output &&
+                in->intrinsic != nir_intrinsic_store_per_primitive_output)
+               continue;
+            nir_io_semantics io = nir_intrinsic_io_semantics(in);
+            if (io.location >= 64)
+               return false;
+            if (BITFIELD64_BIT(io.location) & SPECIAL_MS_OUT_MASK)
