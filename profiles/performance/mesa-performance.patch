+/* Experimental export-side reconstruction of terminal expansion copies.
+ * Original staging remains live; no synchronization is removed. */
+static bool
+ms_direct_tree(nir_def *v, nir_def *root, unsigned depth)
+{
+   if (v == root) return true;
+   if (depth > 48) return false;
+   nir_instr *i = nir_def_instr(v);
+   if (i->type == nir_instr_type_load_const) return true;
+   if (i->type == nir_instr_type_alu) {
+      nir_alu_instr *a = nir_instr_as_alu(i);
+      for (unsigned j = 0; j < nir_op_infos[a->op].num_inputs; j++)
+         if (!ms_direct_tree(a->src[j].src.ssa, root, depth + 1)) return false;
+      return true;
+   }
+   if (i->type != nir_instr_type_intrinsic) return false;
+   nir_intrinsic_instr *in = nir_instr_as_intrinsic(i);
+   return in->intrinsic == nir_intrinsic_load_shared &&
+          !(nir_intrinsic_access(in) & ACCESS_VOLATILE) &&
+          ms_direct_tree(in->src[0].ssa, root, depth + 1);
+}
