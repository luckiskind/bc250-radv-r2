+/* Delay byte expansion only across pure, non-fixed-register VALU instructions.
+ * Stay in one block and stop at the first consumer or any other boundary. */
+static void
+bc250_delay_byte_decode(Program* program)
+{
+   if (!program->info.bc250_late_decode)
+      return;
+   for (Block& block : program->blocks) {
+      auto& ins = block.instructions;
+      for (size_t i = ins.size(); i-- > 0;) {
+         Instruction* cur = ins[i].get();
+         if (cur->opcode != aco_opcode::v_cvt_f32_ubyte0 &&
+             cur->opcode != aco_opcode::v_cvt_f32_ubyte1 &&
+             cur->opcode != aco_opcode::v_cvt_f32_ubyte2 &&
+             cur->opcode != aco_opcode::v_cvt_f32_ubyte3)
+            continue;
+         if (cur->definitions.size() != 1 || cur->definitions[0].isFixed() ||
+             cur->operands.size() != 1 || !cur->operands[0].isTemp() ||
+             cur->operands[0].isFixed())
+            continue;
+         unsigned id = cur->definitions[0].tempId();
+         size_t j = i + 1;
+         for (; j < ins.size(); j++) {
+            Instruction* next = ins[j].get();
+            bool stop = !next->isVALU();
+            for (const Operand& op : next->operands)
+               stop |= op.isFixed() || (op.isTemp() && op.tempId() == id);
+            for (const Definition& def : next->definitions)
+               stop |= def.isFixed();
+            if (stop)
+               break;
+         }
+         if (j > i + 1)
+            std::rotate(ins.begin() + i, ins.begin() + i + 1, ins.begin() + j);
+      }
+   }
+}
