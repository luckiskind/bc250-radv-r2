diff --git a/src/util/bc250_profile.h b/src/util/bc250_profile.h
new file mode 100644
index 0000000..c27aa55
--- /dev/null
+++ b/src/util/bc250_profile.h
@@ -0,0 +1,64 @@
+/* Isolated BC250 profiler. Linux only; disabled unless BC250_PROFILE_DIR is set. */
+#ifndef BC250_PROFILE_H
+#define BC250_PROFILE_H
+#include <stdint.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <time.h>
+#include <sys/syscall.h>
+#include <stdarg.h>
+
+static pthread_once_t bcp_once = PTHREAD_ONCE_INIT;
+static int bcp_fd = -1;
+static uint64_t bcp_start, bcp_end;
+static void bcp_init(void)
+{
+   const char *dir = getenv("BC250_PROFILE_DIR");
+   if (!dir) return;
+   char path[4096];
+   int n = snprintf(path, sizeof(path), "%s/events-%d.jsonl", dir, (int)getpid());
+   if (n < 0 || n >= (int)sizeof(path)) return;
+   const char *s = getenv("BC250_PROFILE_START_NS"), *e = getenv("BC250_PROFILE_END_NS");
+   bcp_start = s ? strtoull(s, NULL, 10) : 0;
+   bcp_end = e ? strtoull(e, NULL, 10) : UINT64_MAX;
+   bcp_fd = open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
+}
+static uint64_t bcp_now(void)
+{
+   struct timespec t;
+   clock_gettime(CLOCK_MONOTONIC, &t);
+   return (uint64_t)t.tv_sec * 1000000000ull + t.tv_nsec;
+}
+static uint64_t bcp_begin(void)
+{
+   pthread_once(&bcp_once, bcp_init);
+   if (bcp_fd < 0) return 0;
+   uint64_t t = bcp_now();
+   return t >= bcp_start && t < bcp_end ? t : 0;
+}
+/* Single append per record; no blocking GPU wait or forced device idle. */
+static void bcp_write(const char *fmt, ...)
+{
+   pthread_once(&bcp_once, bcp_init);
+   if (bcp_fd < 0) return;
+   char line[1024];
+   va_list ap; va_start(ap, fmt);
+   int n = vsnprintf(line, sizeof(line), fmt, ap);
+   va_end(ap);
+   if (n > 0 && n < (int)sizeof(line)) {
+      ssize_t written = write(bcp_fd, line, n);
+      (void)written; /* Incomplete records are rejected by the reader. */
+   }
+}
+static void bcp_cpu(const char *name, uint64_t start, const void *queue, int result)
+{
+   if (!start) return;
+   uint64_t end = bcp_now();
+   bcp_write("{\"kind\":\"cpu\",\"name\":\"%s\",\"pid\":%d,\"tid\":%ld,\"queue\":\"%p\",\"start_ns\":%llu,\"end_ns\":%llu,\"result\":%d}\n",
+             name, (int)getpid(), (long)syscall(SYS_gettid), queue,
+             (unsigned long long)start, (unsigned long long)end, result);
+}
+#endif
