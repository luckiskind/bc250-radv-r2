+static nir_def *ms_direct_clone(nir_builder *, nir_def *, nir_def *, nir_def *, lower_ngg_ms_state *);
+struct ms_direct_clone_ctx { nir_builder *b; nir_def *root; nir_def *index; lower_ngg_ms_state *s; };
+static bool
+ms_direct_clone_src(nir_src *src, void *data)
+{
+   struct ms_direct_clone_ctx *c = data;
+   nir_src_rewrite(src, ms_direct_clone(c->b, src->ssa, c->root, c->index, c->s));
+   return true;
+}
+static nir_def *
+ms_direct_clone(nir_builder *b, nir_def *v, nir_def *root, nir_def *index, lower_ngg_ms_state *s)
+{
+   if (v == root) return index;
+   for (unsigned loc = 0; loc < 64; loc++)
+      for (unsigned c = 0; c < 4; c++)
+         if (s->direct_uniform_offsets[loc][c] && s->direct_values[loc][c] == v)
+            return nir_load_shared(b, 1, 32, nir_imm_int(b, 0),
+               .base = s->direct_uniform_base + s->direct_uniform_offsets[loc][c] - 1,
+               .align_mul = 4);
+   nir_instr *copy = nir_instr_clone(b->shader, nir_def_instr(v));
+   nir_builder_instr_insert(b, copy);
+   b->cursor = nir_before_instr(copy);
+   struct ms_direct_clone_ctx c = {b, root, index, s};
+   nir_foreach_src(copy, ms_direct_clone_src, &c);
+   b->cursor = nir_after_instr(copy);
+   return nir_instr_def(copy);
+}
