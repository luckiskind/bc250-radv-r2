+/* BC250_QUEUE_PROBE_DIAGNOSTIC_V1 */
+/* Diagnostic policy only. No Vulkan calls, GPU waits, or capability changes. */
+enum bc250_queue_probe_mode
+{
+    BC250_QUEUE_PROBE_OFF,
+    BC250_QUEUE_PROBE_OBSERVE,
+    BC250_QUEUE_PROBE_COMPUTE,
+    BC250_QUEUE_PROBE_TRANSFER,
+    BC250_QUEUE_PROBE_BOTH,
+};
+
+static int bc250_parse_queue_probe(const char *name)
+{
+    if (!name || !name[0] || !strcmp(name, "off"))
+        return BC250_QUEUE_PROBE_OFF;
+    if (!strcmp(name, "observe"))
+        return BC250_QUEUE_PROBE_OBSERVE;
+    if (!strcmp(name, "compute-to-graphics"))
+        return BC250_QUEUE_PROBE_COMPUTE;
+    if (!strcmp(name, "transfer-to-graphics"))
+        return BC250_QUEUE_PROBE_TRANSFER;
+    if (!strcmp(name, "both-to-graphics"))
+        return BC250_QUEUE_PROBE_BOTH;
+    return -1;
+}
+
+static bool bc250_probe_conflicts(int mode, bool single_queue)
+{
+    return mode < 0 || (single_queue && mode >= BC250_QUEUE_PROBE_COMPUTE);
+}
+
+static bool bc250_original_transfer_policy(bool vendor_policy, const unsigned int *families)
+{
+    return vendor_policy ||
+            families[VKD3D_QUEUE_FAMILY_TRANSFER] == families[VKD3D_QUEUE_FAMILY_COMPUTE] ||
+            families[VKD3D_QUEUE_FAMILY_TRANSFER] == families[VKD3D_QUEUE_FAMILY_GRAPHICS];
+}
+
+static void bc250_apply_queue_probe(unsigned int *families, int mode)
+{
+    const unsigned int graphics = families[VKD3D_QUEUE_FAMILY_GRAPHICS];
+    if (mode == BC250_QUEUE_PROBE_COMPUTE || mode == BC250_QUEUE_PROBE_BOTH)
+        families[VKD3D_QUEUE_FAMILY_COMPUTE] = graphics;
+    if (mode == BC250_QUEUE_PROBE_TRANSFER || mode == BC250_QUEUE_PROBE_BOTH)
+        families[VKD3D_QUEUE_FAMILY_TRANSFER] = graphics;
+    /* INTERNAL_COMPUTE and all other roles are deliberately untouched. */
+}
+
 static HRESULT vkd3d_select_queues(const struct d3d12_device *device,
         VkPhysicalDevice physical_device, struct vkd3d_device_queue_info *info)
 {
@@ -3612,11 +3674,28 @@ static HRESULT vkd3d_select_queues(const struct d3d12_device *device,
     VkQueueFamilyProperties *queue_properties = NULL;
     VkDeviceQueueCreateInfo *queue_info = NULL;
     bool duplicate, single_queue;
+    char bc250_probe_env[64] = {0};
+    int bc250_probe;
     unsigned int i, j;
     uint32_t count;
 
     memset(info, 0, sizeof(*info));
     single_queue = !!(vkd3d_config_flags & VKD3D_CONFIG_FLAG_SINGLE_QUEUE);
+    vkd3d_get_env_var("VKD3D_BC250_QUEUE_PROBE", bc250_probe_env, sizeof(bc250_probe_env));
+    bc250_probe_env[sizeof(bc250_probe_env) - 1] = 0;
+    bc250_probe = bc250_parse_queue_probe(bc250_probe_env);
+    if (bc250_probe_conflicts(bc250_probe, single_queue))
+    {
+        ERR("BC250 queue probe: invalid mode or conflict with single_queue.\n");
+        return E_INVALIDARG;
+    }
+    if (bc250_probe != BC250_QUEUE_PROBE_OFF &&
+            device->device_info.properties2.properties.vendorID != 0x1002)
+    {
+        ERR("BC250 queue probe: refusing a non-AMD device.\n");
+        return E_INVALIDARG;
+    }
+
 
     VK_CALL(vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &count, NULL));
     if (!(queue_properties = vkd3d_calloc(count, sizeof(*queue_properties))))
@@ -3659,6 +3738,20 @@ static HRESULT vkd3d_select_queues(const struct d3d12_device *device,
         info->family_index[VKD3D_QUEUE_FAMILY_TRANSFER] = info->family_index[VKD3D_QUEUE_FAMILY_COMPUTE];
 
     info->family_index[VKD3D_QUEUE_FAMILY_INTERNAL_COMPUTE] = info->family_index[VKD3D_QUEUE_FAMILY_COMPUTE];
+    info->bc250_probe_mode = (unsigned int)bc250_probe;
+    if (bc250_probe != BC250_QUEUE_PROBE_OFF)
+    {
